{
  "name": "hexum-monorepo",
  "private": true,
  "workspaces": [
    "shared",
    "client"
  ],
  "dependencies": {
    "firebase": "^12.12.1"
  },
  "scripts": {
    "dev": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "lint": "npm run lint --workspace client",
    "typecheck": "npm run typecheck --workspace client",
    "test": "npm run test --workspace shared && npm run test --workspace client",
    "test:shared": "npm run test --workspace shared",
    "test:client": "npm run test --workspace client",
    "test:rules": "firebase emulators:exec --project demo-hexum --only firestore \"vitest run --config vitest.rules.config.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.30.2"
  }
}
