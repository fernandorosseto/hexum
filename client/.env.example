# ============================================================
#  Credenciais do Firebase (client/.env)
#  Copie para `client/.env` e preencha com os valores do seu projeto:
#  console.firebase.google.com -> Configurações do projeto -> Seus apps
#
#  Sem estas variáveis o jogo roda normalmente offline (solo e sandbox);
#  apenas o PvP fica indisponível.
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modo de autenticação:
#   guest    (padrão) entra direto, sem tela de login, usando login anônimo
#            do Firebase quando ele estiver configurado
#   firebase exige conta (e-mail/senha ou Google) e mostra a tela de login
VITE_AUTH_MODE=guest
